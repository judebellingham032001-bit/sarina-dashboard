<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sarina Store Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { 
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); 
            min-height: 100vh; font-family: 'Inter', sans-serif; padding: 20px 0;
        }
        .nav-custom { 
            background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);
            border-radius: 50px; padding: 8px; box-shadow: 0 8px 32px rgba(31, 38, 135, 0.1);
        }
        .nav-pills .nav-link { border-radius: 50px; color: #444; font-weight: 700; border: none; padding: 12px 25px; }
        .nav-pills .nav-link.active { background: linear-gradient(45deg, #007bff, #00c6ff) !important; box-shadow: 0 4px 15px rgba(0, 123, 255, 0.4); }
        
        .card-main { 
            background: white; border-radius: 24px; border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08); padding: 25px; margin-bottom: 25px;
        }
        
        /* Mobile Fix: Menghindari teks angka pecah/turun ke bawah */
        .nowrap { white-space: nowrap !important; }
        .table td, .table th { vertical-align: middle; }

        .content-section { display: none; }
        .content-section.active { display: block; animation: slideUp 0.4s ease-out; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        .filter-box { background: #f8f9fa; border-radius: 15px; padding: 15px; margin-bottom: 20px; border: 1px solid #eee; }
        
        .badge-status { padding: 6px 14px; border-radius: 50px; font-size: 0.7rem; font-weight: 800; }
        .bg-habis { background: #ff7675; color: white; } 
        .bg-low { background: #fdcb6e; color: #2d3436; }
        .bg-aman { background: #55efc4; color: #006266; }

        .saldo-card {
            background: linear-gradient(45deg, #2d3436, #000000); color: white;
            border-radius: 20px; padding: 30px; text-align: center; margin-bottom: 25px;
        }
        .saldo-minus { background: linear-gradient(45deg, #d63031, #8b0000) !important; }
    </style>
</head>
<body>

<div class="container">
    <div class="d-flex justify-content-center mb-4">
        <ul class="nav nav-pills nav-custom shadow-sm">
            <li class="nav-item"><button class="nav-link active" onclick="openMenu('stocks', this)">STOCKS</button></li>
            <li class="nav-item"><button class="nav-link" onclick="openMenu('shipping', this)">SHIPPING</button></li>
            <li class="nav-item"><button class="nav-link" onclick="openMenu('kas', this)">KAS</button></li>
        </ul>
    </div>

    <div id="stocks" class="content-section active">
        <div class="card-main">
            <div class="text-center mb-4">
                <span class="badge bg-primary rounded-pill px-3 py-2">Terakhir Update: <%= lastUpdate %></span>
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Produk</th><th>Quantity</th><th class="text-center">Status</th></tr></thead>
                    <tbody>
                        <% stocks.forEach(s => { %>
                            <tr>
                                <td class="fw-bold"><%= s.nama %></td>
                                <td class="nowrap text-muted fw-bold"><%= s.display %></td>
                                <td class="text-center">
                                    <span class="badge-status <%= s.qty <= 0 ? 'bg-habis' : (s.qty <= 2 ? 'bg-low' : 'bg-aman') %>">
                                        <%= s.qty <= 0 ? 'HABIS' : (s.qty <= 2 ? 'LOW' : 'TERSEDIA') %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="shipping" class="content-section">
        <div class="card-main">
            <div class="filter-box d-flex gap-2">
                <select id="shipMonth" class="form-select" onchange="filterData('tableShip', 'shipMonth', 'shipYear')">
                    <option value="">Semua Bulan</option>
                    <option value="/01/">Januari</option><option value="/02/">Februari</option><option value="/03/">Maret</option>
                    <option value="/04/">April</option><option value="/05/">Mei</option><option value="/06/">Juni</option>
                    <option value="/07/">Juli</option><option value="/08/">Agustus</option><option value="/09/">September</option>
                    <option value="/10/">Oktober</option><option value="/11/">November</option><option value="/12/">Desember</option>
                </select>
                <select id="shipYear" class="form-select" onchange="filterData('tableShip', 'shipMonth', 'shipYear')">
                    <option value="">Semua Tahun</option>
                    <option value="2024">2024</option><option value="2025">2025</option><option value="2026">2026</option>
                </select>
            </div>
            <div class="table-responsive">
                <table class="table text-center align-middle" id="tableShip">
                    <thead class="table-dark"><tr><th>Tgl</th><th>SPX</th><th>JNE</th><th>J&T</th><th>Same/Inst</th><th>Total</th></tr></thead>
                    <tbody>
                        <% shippingAll.forEach(k => { %>
                            <tr class="data-row"><td class="nowrap fw-bold"><%= k.tgl %></td><td><%= k.spx %></td><td><%= k.jne %></td><td><%= k.jnt %></td><td><%= k.sd %></td><td class="nowrap fw-bold text-primary"><%= k.tot %></td></tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="kas" class="content-section">
        <div class="saldo-card <%= saldoTotal.includes('-') ? 'saldo-minus' : '' %>">
            <p class="small fw-bold opacity-75 mb-1 text-uppercase">Total Saldo Kas</p>
            <h1 class="display-4 fw-bold">Rp <%= saldoTotal %></h1>
        </div>
        <div class="card-main">
            <div class="filter-box d-flex gap-2 mb-3">
                <select id="kasMonth" class="form-select" onchange="filterData('tableKas', 'kasMonth', 'kasYear')">
                    <option value="">Pilih Bulan</option>
                    <option value="/01/">Januari</option><option value="/02/">Februari</option><option value="/03/">Maret</option>
                    <option value="/04/">April</option><option value="/05/">Mei</option><option value="/06/">Juni</option>
                    <option value="/07/">Juli</option><option value="/08/">Agustus</option><option value="/09/">September</option>
                    <option value="/10/">Oktober</option><option value="/11/">November</option><option value="/12/">Desember</option>
                </select>
                <select id="kasYear" class="form-select" onchange="filterData('tableKas', 'kasMonth', 'kasYear')">
                    <option value="">Tahun</option>
                    <option value="2024">2024</option><option value="2025">2025</option><option value="2026">2026</option>
                </select>
            </div>
            <div class="table-responsive">
                <table class="table align-middle" id="tableKas">
                    <thead class="table-light"><tr><th>Tgl</th><th>Keterangan</th><th class="text-end">Debet</th><th class="text-end">Kredit</th><th class="text-end">Saldo</th><th class="text-center">Bukti</th></tr></thead>
                    <tbody>
                        <% kasAll.forEach(t => { %>
                            <tr class="data-row" style="font-size: 0.85rem;">
                                <td class="nowrap text-muted"><%= t.tgl %></td>
                                <td><div class="fw-bold text-uppercase"><%= t.kat %></div><div class="small text-muted"><%= t.ket %></div></td>
                                <td class="text-end text-danger fw-bold nowrap"><%= t.debet != '0' ? '-' + t.debet : '' %></td>
                                <td class="text-end text-success fw-bold nowrap"><%= t.kredit != '0' ? '+' + t.kredit : '' %></td>
                                <td class="text-end fw-bold nowrap"><%= t.saldo %></td>
                                <td class="text-center">
                                    <% if(t.bukti && t.bukti.toLowerCase().includes('http')) { %>
                                        <a href="<%= t.bukti %>" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3" style="font-size: 10px;">BUKTI</a>
                                    <% } else { %> - <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function openMenu(id, el) {
        document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));
        document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
        document.getElementById(id).classList.add('active');
        el.classList.add('active');
    }

    function filterData(tableId, monthId, yearId) {
        const month = document.getElementById(monthId).value;
        const year = document.getElementById(yearId).value;
        const rows = document.querySelectorAll(`#${tableId} .data-row`);

        rows.forEach(row => {
            const dateText = row.cells[0].innerText; // Tgl ada di kolom pertama
            const matchMonth = month === "" || dateText.includes(month);
            const matchYear = year === "" || dateText.includes(year);
            
            row.style.display = (matchMonth && matchYear) ? "" : "none";
        });
    }
</script>
</body>
</html>
