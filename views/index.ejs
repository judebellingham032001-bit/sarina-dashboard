<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Sarina Store</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body { font-family: sans-serif; background: #f4f6f9; margin: 0; padding: 20px; }
        .card { background: white; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); padding: 20px; margin-bottom: 20px; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; background: #007bff; color: white; padding: 15px 20px; border-radius: 15px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { padding: 12px; border-bottom: 1px solid #eee; text-align: left; }
        th { background: #f8f9fa; color: #333; }
        .badge { padding: 5px 10px; border-radius: 20px; font-size: 12px; font-weight: bold; }
        .bg-success { background: #d4edda; color: #155724; }
        .bg-danger { background: #f8d7da; color: #721c24; }
        .bg-warning { background: #fff3cd; color: #856404; }
        .btn-bukti { color: #007bff; text-decoration: none; font-size: 18px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
    </style>
</head>
<body>

    <div class="header">
        <h2 style="margin:0"><i class="fas fa-store"></i> SARINA STORE</h2>
        <div style="text-align:right">
            <small>Update: <%= lastUpdate %></small><br>
            <strong>Saldo: Rp <%= saldoTotal %></strong>
        </div>
    </div>

    <div class="grid">
        <div class="card">
            <h3><i class="fas fa-boxes"></i> Monitoring Stok</h3>
            <table>
                <thead>
                    <tr><th>Barang</th><th>Stok</th><th>Ket</th></tr>
                </thead>
                <tbody>
                    <% stocks.forEach(item => { %>
                        <tr>
                            <td><%= item.nama %></td>
                            <td>
                                <span class="badge <%= item.qty <= 5 ? 'bg-danger' : (item.qty <= 15 ? 'bg-warning' : 'bg-success') %>">
                                    <%= item.qty %>
                                </span>
                            </td>
                            <td><%= item.ds %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <div class="card">
            <h3><i class="fas fa-wallet"></i> Mutasi Kas</h3>
            <table>
                <thead>
                    <tr><th>Tgl</th><th>Ket</th><th>Amount</th><th>Bukti</th></tr>
                </thead>
                <tbody>
                    <% kasAll.slice(-10).reverse().forEach(t => { %>
                        <tr>
                            <td><small><%= t.tgl %></small></td>
                            <td><strong><%= t.kat %></strong><br><small><%= t.ket %></small></td>
                            <td style="color: <%= t.debet != '0' ? 'red' : 'green' %>">
                                <%= t.debet != '0' ? '-' + t.debet : '+' + t.kredit %>
                            </td>
                            <td>
                                <% if(t.bukti && t.bukti.includes('http')) { %>
                                    <a href="<%= t.bukti %>" target="_blank" class="btn-bukti"><i class="fas fa-file-invoice-dollar"></i></a>
                                <% } else { %> - <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <h3><i class="fas fa-truck"></i> Rekap Pengiriman</h3>
        <div style="overflow-x:auto">
            <table>
                <thead>
                    <tr><th>Tanggal</th><th>SPX</th><th>JNE</th><th>J&T</th><th>Sameday</th><th>Total</th></tr>
                </thead>
                <tbody>
                    <% shippingAll.slice(-7).reverse().forEach(s => { %>
                        <tr>
                            <td><%= s.tgl %></td>
                            <td><%= s.spx %></td>
                            <td><%= s.jne %></td>
                            <td><%= s.jnt %></td>
                            <td><%= s.sd %></td>
                            <td><strong><%= s.tot %></strong></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

</body>
</html>
