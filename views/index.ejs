<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SARINA DASHBOARD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f1f5f9; font-family: sans-serif; padding: 20px; }
        .card { border-radius: 15px; border: none; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        .btn-dark { background: #000; border-radius: 12px; font-weight: bold; padding: 12px; }
    </style>
</head>
<body>
    <div class="container" style="max-width: 450px;">
        <h2 class="text-center fw-bold mb-4">SARINA STORE</h2>

        <div class="card p-4">
            <h5 class="fw-bold mb-3">CARI INVOICE / RESI</h5>
            <div class="mb-3">
                <label class="small fw-bold text-muted">BULAN (Contoh: MARET 2026)</label>
                <input type="text" id="bln" class="form-control" placeholder="MARET 2026">
            </div>
            <div class="mb-3">
                <label class="small fw-bold text-muted">TANGGAL (Contoh: 22-03-2026)</label>
                <input type="text" id="tgl" class="form-control" placeholder="22-03-2026">
            </div>
            <button onclick="cariKeDrive()" class="btn btn-dark w-100">CARI DI GOOGLE DRIVE</button>
            <p class="mt-3 small text-muted text-center">Web akan membuka folder Drive & mencari file secara otomatis.</p>
        </div>
    </div>

    <script>
        function cariKeDrive() {
            const b = document.getElementById('bln').value;
            const t = document.getElementById('tgl').value;
            if(!b || !t) return alert("Isi dulu Bos!");

            // Trik: Kita arahkan browser langsung ke pencarian Drive user
            // Ini akan mencari file yang mengandung tanggal di dalam Drive kamu
            const query = encodeURIComponent(`${t} ${b}`);
            const driveSearchUrl = `https://drive.google.com/drive/search?q=${query}`;
            
            window.open(driveSearchUrl, '_blank');
        }
    </script>
</body>
</html>
