<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SARINA DASHBOARD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f1f5f9; font-family: sans-serif; padding: 20px; }
        .card { border-radius: 12px; border: none; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
        .nav-link { font-weight: bold; color: #64748b; cursor: pointer; }
        .nav-pills .nav-link.active { background-color: #000 !important; }
        .section { display: none; } .section.active { display: block; }
    </style>
</head>
<body>
    <div class="container" style="max-width: 500px;">
        <div class="text-center mb-4">
            <h2 class="fw-bold">SARINA STORE</h2>
            <p class="text-muted small fw-bold">DIRECT SYSTEM</p>
        </div>

        <ul class="nav nav-pills nav-justified bg-white p-1 rounded-3 mb-4 shadow-sm">
            <li class="nav-item"><a class="nav-link active" onclick="tab('stok', this)">STOK</a></li>
            <li class="nav-item"><a class="nav-link" onclick="tab('resi', this)">RESI</a></li>
        </ul>

        <div id="stok" class="section active">
            <div class="card p-3">
                <table class="table mb-0">
                    <% stocks.forEach(s => { %>
                        <tr>
                            <td><b><%= s.nama %></b></td>
                            <td class="text-end"><span class="badge bg-success"><%= s.statusTxt %></span></td>
                        </tr>
                    <% }) %>
                </table>
            </div>
        </div>

        <div id="resi" class="section">
            <div class="card p-4">
                <div class="mb-3">
                    <label class="small fw-bold">BULAN (Contoh: FEBRUARI 2026)</label>
                    <input type="text" id="bln" class="form-control" placeholder="FEBRUARI 2026">
                </div>
                <div class="mb-3">
                    <label class="small fw-bold">TANGGAL (Contoh: 01-02-2026)</label>
                    <input type="text" id="tgl" class="form-control" placeholder="01-02-2026">
                </div>
                <button onclick="cariResi()" class="btn btn-dark w-100 fw-bold">CARI DI DRIVE</button>
                <div id="hasil" class="mt-4"></div>
            </div>
        </div>
    </div>

    <script>
        function tab(id, el) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            el.classList.add('active');
        }

        async function cariResi() {
            const b = document.getElementById('bln').value;
            const t = document.getElementById('tgl').value;
            const h = document.getElementById('hasil');
            
            // LINK GOOGLE APPS SCRIPT KETUA
            const scriptUrl = "https://script.google.com/macros/s/AKfycbzreEqA8cBXoH2wuDpipchslc7pX5hWn0Kk-JOedaBVe3MEZo85VAXJgXwQhSwhJGJwKg/exec";

            if(!b || !t) return alert("Isi data dulu Bos!");
            h.innerHTML = '<div class="text-center small">🔍 Menghubungi Google Drive...</div>';

            try {
                // KITA TEMBAK LANGSUNG DARI BROWSER (CLIENT-SIDE)
                const finalUrl = `${scriptUrl}?tgl=${t}&bulan=${b}`;
                const res = await fetch(finalUrl);
                const data = await res.json();

                if(!data || data.length === 0) {
                    h.innerHTML = '<div class="alert alert-warning small">Data tidak ditemukan.</div>';
                    return;
                }

                let html = '<div class="list-group shadow-sm">';
                data.forEach(f => {
                    html += `<a href="${f.url}" target="_blank" class="list-group-item list-group-item-action fw-bold small py-3">${f.name}</a>`;
                });
                h.innerHTML = html + '</div>';
            } catch (e) {
                console.error(e);
                h.innerHTML = '<div class="alert alert-danger small">Gagal konek! Pastikan Apps Script sudah di-deploy "Anyone".</div>';
            }
        }
    </script>
</body>
</html>
