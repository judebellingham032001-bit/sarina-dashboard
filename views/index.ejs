<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sarina Store Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f7f6; color: #333; font-family: sans-serif; padding: 20px 0; }
        .container { max-width: 600px; }
        .header { text-align: center; margin-bottom: 20px; }
        .nav-custom { display: flex; justify-content: center; gap: 10px; margin-bottom: 20px; }
        .nav-link { 
            background: #ddd; border: none; padding: 10px 20px; 
            border-radius: 5px; cursor: pointer; font-weight: bold; 
        }
        .nav-link.active { background: #007bff; color: white; }
        .card-main { background: white; border-radius: 10px; padding: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .content-section { display: none; }
        .content-section.active { display: block; }
        .table { font-size: 14px; }
        .badge-status { padding: 4px 8px; border-radius: 4px; font-size: 11px; color: white; font-weight: bold; }
        .bg-habis { background: #dc3545; }
        .bg-low { background: #ffc107; color: #000; }
        .bg-aman { background: #28a745; }
        .saldo-total { background: #28a745; color: white; padding: 15px; border-radius: 10px; text-align: center; margin-bottom: 15px; }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h4 class="fw-bold">SARINA STORE</h4>
        <p class="text-muted small">Update: <%= lastUpdate %></p>
    </div>

    <div class="nav-custom">
        <button class="nav-link active" onclick="openMenu('stocks', this)">STOK</button>
        <button class="nav-link" onclick="openMenu('shipping', this)">KIRIM</button>
        <button class="nav-link" onclick="openMenu('kas', this)">KAS</button>
    </div>

    <div id="stocks" class="content-section active">
        <div class="card-main">
            <table class="table">
                <thead><tr><th>Produk</th><th class="text-center">Status</th></tr></thead>
                <tbody>
                    <% stocks.forEach(s => { %>
                        <tr>
                            <td><strong><%= s.nama %></strong><br><small class="text-muted"><%= s.display %></small></td>
                            <td class="text-center align-middle">
                                <span class="badge-status <%= s.qty <= 0 ? 'bg-habis' : (s.qty <= 2 ? 'bg-low' : 'bg-aman') %>">
                                    <%= s.qty <= 0 ? 'HABIS' : (s.qty <= 2 ? 'LOW' : 'ADA') %>
                                </span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <div id="shipping" class="content-section">
        <div class="card-main">
            <table class="table text-center">
                <thead class="table-light"><tr><th>Tgl</th><th>SPX</th><th>JNE</th><th>J&T</th><th>TOT</th></tr></thead>
                <tbody>
                    <% shippingAll.slice(-10).forEach(k => { %>
                        <tr>
                            <td class="text-start"><%= k.tgl %></td>
                            <td><%= k.spx %></td><td><%= k.jne %></td><td><%= k.jnt %></td>
                            <td class="fw-bold text-primary"><%= k.tot %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <div id="kas" class="content-section">
        <div class="saldo-total">
            <small>SALDO AKHIR</small>
            <h3 class="fw-bold m-0"><%= saldoTotal %></h3>
        </div>
        <div class="card-main">
            <table class="table">
                <thead class="table-light"><tr><th>Ket</th><th class="text-end">Mutasi</th></tr></thead>
                <tbody>
                    <% kasAll.slice(-10).forEach(t => { %>
                        <tr>
                            <td><small class="text-muted"><%= t.tgl %></small><br><strong><%= t.kat %></strong></td>
                            <td class="text-end align-middle">
                                <div class="fw-bold <%= (t.debet && t.debet != '0') ? 'text-danger' : 'text-success' %>">
                                    <%= (t.debet && t.debet != '0') ? '-' + t.debet : '+' + t.kredit %>
                                </div>
                                <small class="text-muted" style="font-size: 10px;">Sisa: <%= t.saldo %></small>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function openMenu(id, el) {
        // Sembunyikan semua section
        document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));
        // Nonaktifkan semua button
        document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
        // Tampilkan yang dipilih
        document.getElementById(id).classList.add('active');
        el.classList.add('active');
    }
</script>

</body>
</html>
