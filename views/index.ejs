<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Sarina Store Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Inter', sans-serif; padding-top: 20px; }
        .nav-custom { background: white; border-radius: 50px; padding: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .nav-link { border-radius: 50px; color: #666; font-weight: bold; border: none; padding: 10px 25px; transition: 0.3s; }
        .nav-link.active { background: #007bff !important; color: white !important; }
        .card-main { background: white; border-radius: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); padding: 25px; margin-bottom: 20px; border:none; }
        .content-section { display: none; }
        .content-section.active { display: block; animation: fadeIn 0.4s; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        /* 10 Baris terakhir ditampilkan di awal */
        .limit-view tr:nth-last-child(n+11) { display: none; }
        .full-view tr { display: table-row !important; }
        .btn-more { background: #e9ecef; border: none; border-radius: 12px; padding: 12px; width: 100%; color: #007bff; font-weight: bold; margin-top: 15px; }
        .badge-status { padding: 6px 14px; border-radius: 50px; font-size: 0.75rem; font-weight: 800; }
        .bg-habis { background: #ffe5e5; color: #d63031; } 
        .bg-low { background: #fff9db; color: #e67e22; }
        .bg-aman { background: #e3fcef; color: #00b894; }
    </style>
</head>
<body>

<div class="container">
    <div class="d-flex justify-content-center mb-4">
        <ul class="nav nav-pills nav-custom shadow-sm">
            <li class="nav-item"><button class="nav-link active" onclick="openMenu('stocks', this)">Stocks</button></li>
            <li class="nav-item"><button class="nav-link" onclick="openMenu('shipping', this)">Shipping</button></li>
            <li class="nav-item"><button class="nav-link" onclick="openMenu('kas', this)">Kas</button></li>
        </ul>
    </div>

    <div id="stocks" class="content-section active">
        <div class="card-main">
            <div class="text-center mb-4">
                <span class="text-muted fw-bold">Terakhir Update: </span>
                <span class="text-primary fw-bold"><%= lastUpdate %></span>
            </div>
            <table class="table align-middle">
                <thead class="table-light"><tr><th>Produk</th><th>Quantity</th><th class="text-center">Status</th></tr></thead>
                <tbody>
                    <% stocks.forEach(s => { %>
                        <tr>
                            <td class="fw-bold text-uppercase"><%= s.nama %></td>
                            <td><span class="text-muted fw-bold"><%= s.display %></span></td>
                            <td class="text-center">
                                <% if(s.qty <= 0) { %>
                                    <span class="badge-status bg-habis">HABIS</span>
                                <% } else if(s.qty >= 1 && s.qty <= 2) { %>
                                    <span class="badge-status bg-low">LOW STOCK</span>
                                <% } else { %>
                                    <span class="badge-status bg-aman">TERSEDIA</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <div id="shipping" class="content-section">
        <div class="card-main">
            <h5 class="fw-bold mb-3"><i class="fas fa-truck-fast me-2"></i>History Shipping</h5>
            <div class="table-responsive">
                <table class="table text-center align-middle limit-view" id="tableShip">
                    <thead class="table-dark small"><tr><th>Tanggal</th><th>SPX</th><th>JNE</th><th>J&T</th><th>Same/Inst</th><th>Total</th></tr></thead>
                    <tbody>
                        <% shippingAll.forEach(k => { %>
                            <tr><td class="small fw-bold text-start"><%= k.tgl %></td><td><%= k.spx %></td><td><%= k.jne %></td><td><%= k.jnt %></td><td><%= k.sd %></td><td class="fw-bold text-primary"><%= k.tot %></td></tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <button class="btn-more" onclick="toggleView('tableShip', this)">Lihat Semua History Shipping</button>
        </div>
    </div>

    <div id="kas" class="content-section">
        <div class="card-main">
            <div class="text-center mb-4 p-4 bg-light rounded-4 border">
                <p class="text-muted small fw-bold mb-1 text-uppercase">Total Saldo Akhir</p>
                <h1 class="display-5 fw-bold <%= saldoTotal.includes('-') ? 'text-danger' : 'text-success' %>">
                    Rp <%= saldoTotal %>
                </h1>
            </div>
            <div class="table-responsive">
                <table class="table align-middle limit-view" id="tableKas">
                    <thead class="table-light small"><tr><th>Tgl</th><th>Keterangan</th><th class="text-end">Debet</th><th class="text-end">Kredit</th><th class="text-end">Saldo</th><th class="text-center">Bukti</th></tr></thead>
                    <tbody>
                        <% kasAll.forEach(t => { %>
                            <tr style="font-size: 0.85rem;">
                                <td class="text-muted"><%= t.tgl %></td>
                                <td><div class="fw-bold text-uppercase"><%= t.kat %></div><div class="small text-muted"><%= t.ket %></div></td>
                                <td class="text-end text-danger fw-bold"><%= t.debet != '0' ? '-' + t.debet : '' %></td>
                                <td class="text-end text-success fw-bold"><%= t.kredit != '0' ? '+' + t.kredit : '' %></td>
                                <td class="text-end fw-bold"><%= t.saldo %></td>
                                <td class="text-center">
                                    <% if(t.bukti && t.bukti.toLowerCase().includes('http')) { %>
                                        <a href="<%= t.bukti %>" target="_blank" class="btn btn-sm btn-outline-primary fw-bold" style="font-size: 0.7rem;">Bukti Transaksi</a>
                                    <% } else { %> - <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <button class="btn-more" onclick="toggleView('tableKas', this)">Lihat Semua History Kas</button>
        </div>
    </div>
</div>

<script>
    function openMenu(id, el) {
        document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));
        document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
        document.getElementById(id).classList.add('active');
        el.classList.add('active');
    }
    function toggleView(tableId, btn) {
        const table = document.getElementById(tableId);
        if (table.classList.contains('limit-view')) {
            table.classList.remove('limit-view'); table.classList.add('full-view');
            btn.innerText = "Sembunyikan Sebagian";
        } else {
            table.classList.remove('full-view'); table.classList.add('limit-view');
            btn.innerText = (tableId === 'tableKas') ? "Lihat Semua History Kas" : "Lihat Semua History Shipping";
        }
    }
</script>
</body>
</html>
