<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sarina Store - Industrial Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { --dark: #1a1d21; --gray: #f8f9fa; --primary: #ffc107; }
        
        body { 
            /* BACKGROUND INDUSTRIAL WAREHOUSE (High Quality & Aesthetic) */
            background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), 
                        url('https://images.unsplash.com/photo-1590496793929-36417d3117de?q=80&w=1600') no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh; 
            font-family: 'Inter', sans-serif; 
            color: white; 
            padding: 20px 0;
        }

        /* LOGO & HEADER */
        .header-logo { display: flex; flex-direction: column; align-items: center; margin-bottom: 25px; text-align: center; }
        .logo-img { width: 130px; border-radius: 20px; box-shadow: 0 4px 15px rgba(255,193,7,0.3); }

        /* NAVIGASI CAPSULE (Industrial Look) */
        .nav-custom { 
            background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px);
            border-radius: 50px; padding: 10px; border: 1px solid rgba(255,255,255,0.2);
            box-shadow: 0 5px 20px rgba(0,0,0,0.4);
        }
        .nav-pills .nav-link { border-radius: 50px; color: rgba(255,255,255,0.7); font-weight: 800; border: none; padding: 10px 20px; transition: 0.3s; }
        .nav-pills .nav-link.active { background: var(--primary) !important; color: #333 !important; }

        /* CARDS (Industrial Transparent) */
        .card-main { 
            background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(15px);
            border-radius: 20px; border: 1px solid rgba(255,255,255,0.1);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5); padding: 20px; margin-bottom: 25px;
            animation: fadeIn 0.5s ease;
        }
        
        @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

        /* TABLE MOBILE FIX & NOWRAP */
        .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .nowrap { white-space: nowrap !important; }
        .content-section { display: none; }
        .content-section.active { display: block; }
        
        .table { color: white !important; margin-bottom: 0; }
        .table-light { --bs-table-bg: rgba(255,255,255,0.05); }

        .filter-area { display: none; background: rgba(0,0,0,0.3); border-radius: 12px; padding: 15px; margin-bottom: 20px; border: 1px solid rgba(255,255,255,0.1); }
        .form-select { background: rgba(255,255,255,0.05); color: white; border: 1px solid rgba(255,255,255,0.2); border-radius: 10px; }
        
        /* BADGES STATUS */
        .badge-status { padding: 5px 12px; border-radius: 50px; font-size: 0.7rem; font-weight: bold; }
        .bg-habis { background: #ee5253; color: white; animation: pulse 2s infinite; } 
        .bg-low { background: #ff9f43; color: #333; } 
        .bg-aman { background: #10ac84; color: white; }

        @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(238,82,83,0.4); } 70% { box-shadow: 0 0 0 10px rgba(238,82,83,0); } 100% { box-shadow: 0 0 0 0 rgba(238,82,83,0); } }

        /* SALDO KAS */
        .saldo-card { background: rgba(0,0,0,0.4); border-radius: 15px; padding: 25px; text-align: center; margin-bottom: 20px; }
        .saldo-minus h1 { color: #ee5253 !important; }
        .display-4 { font-weight: 800; color: #10ac84; }

        /* BUTTONS */
        .btn-more { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.7); font-weight: bold; width: 100%; border-radius: 10px; padding: 10px; margin-top: 15px; }
        .btn-more:hover { background: rgba(255,255,255,0.1); }
        
        .tgl-format { font-size: 0.8rem; }
    </style>
</head>
<body>

<div class="container">
    <div class="header-logo">
        <img src="https://lh3.googleusercontent.com/zuoLF4h3hqAkI6NziYQd9K03F645672-01" alt="Sarina Store Logo" class="logo-img mb-2">
        <div class="text-white opacity-50 small">Sarina Store Management System</div>
    </div>

    <div class="d-flex justify-content-center mb-4">
        <ul class="nav nav-pills nav-custom shadow-sm">
            <li class="nav-item"><button class="nav-link active" onclick="openMenu('stocks', this)">Stocks</button></li>
            <li class="nav-item"><button class="nav-link" onclick="openMenu('shipping', this)">Shipping</button></li>
            <li class="nav-item"><button class="nav-link" onclick="openMenu('kas', this)">Kas</button></li>
        </ul>
    </div>

    <div id="stocks" class="content-section active">
        <div class="card-main">
            <div class="text-center mb-4 opacity-75 small">Terakhir Update Sheet: <strong class="text-warning"><%= lastUpdate %></strong></div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light"><tr><th>Produk</th><th>Keterangan</th><th class="text-center">Status</th></tr></thead>
                    <tbody>
                        <% stocks.forEach(s => { %>
                            <tr>
                                <td class="fw-bold text-uppercase"><%= s.nama %></td>
                                <td><small class="text-white-50 nowrap"><%= s.display %></small></td>
                                <td class="text-center">
                                    <span class="badge-status <%= s.qty <= 0 ? 'bg-habis' : (s.qty <= 2 ? 'bg-low' : 'bg-aman') %>">
                                        <%= s.qty <= 0 ? 'Habis' : (s.qty <= 2 ? 'Low' : 'Tersedia') %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
