<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sarina Store Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { --glass: rgba(255, 255, 255, 0.85); }
        
        body { 
            /* Background Gudang Modern di-blur */
            background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), 
                        url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1500&q=80');
            background-size: cover;
            background-attachment: fixed;
            background-position: center;
            min-height: 100vh; 
            font-family: 'Inter', sans-serif; 
            padding: 20px 0;
            color: #2d3436;
        }

        /* Navigasi Glassmorphism */
        .nav-custom { 
            background: var(--glass); 
            backdrop-filter: blur(10px); 
            border-radius: 50px; padding: 8px; 
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
            border: 1px solid rgba(255,255,255,0.3);
        }
        .nav-link { border-radius: 50px; color: #444; font-weight: 700; border: none; padding: 12px 25px; transition: 0.3s; }
        .nav-link.active { background: linear-gradient(45deg, #0984e3, #00cec9) !important; color: white !important; }

        /* Card Warehouse Style */
        .card-main { 
            background: var(--glass); 
            backdrop-filter: blur(15px);
            border-radius: 24px; border: 1px solid rgba(255,255,255,0.4);
            box-shadow: 0 15px 35px rgba(0,0,0,0.2); padding: 20px; margin-bottom: 25px;
            animation: slideUp 0.6s ease-out;
        }

        .nowrap { white-space: nowrap !important; }
        .content-section { display: none; }
        .content-section.active { display: block; }

        @keyframes slideUp { 
            from { opacity: 0; transform: translateY(30px); } 
            to { opacity: 1; transform: translateY(0); } 
        }

        .badge-status { padding: 6px 12px; border-radius: 8px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; }
        .bg-habis { background: #ff7675; color: white; animation: pulse 2s infinite; } 
        .bg-low { background: #fdcb6e; color: #2d3436; } 
        .bg-aman { background: #55efc4; color: #006266; }

        @keyframes pulse { 
            0% { box-shadow: 0 0 0 0 rgba(255, 118, 117, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(255, 118, 117, 0); }
            100% { box-shadow: 0 0 0 0 rgba(255, 118, 117, 0); }
        }

        .saldo-card { 
            background: rgba(45, 52, 54, 0.9); backdrop-filter: blur(10px);
            color: white; border-radius: 20px; padding: 25px; text-align: center; margin-bottom: 25px;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .saldo-minus { background: rgba(214, 48, 49, 0.9) !important; }

        .btn-riwayat { 
            background: rgba(9, 132, 227, 0.1); border: 1px dashed #0984e3; 
            padding: 12px; width: 100%; border-radius: 12px; color: #0984e3; 
            font-weight: bold; margin-bottom: 15px; transition: 0.3s;
        }
        .btn-riwayat:hover { background: #0984e3; color: white; }
    </style>
</head>
<body>

<div class="container">
    <div class="d-flex justify-content-center mb-4">
        <ul class="nav nav-pills nav-custom shadow-sm">
            <li class="nav-item"><button class="nav-link active" onclick="openMenu('stocks', this)"><i class="fas fa-boxes-stacked me-1"></i> STOCKS</button></li>
            <li class="nav-item"><button class="nav-link" onclick="openMenu('shipping', this)"><i class="fas fa-truck-fast me-1"></i> SHIPPING</button></li>
            <li class="nav-item"><button class="nav-link" onclick="openMenu('kas', this)"><i class="fas fa-wallet me-1"></i> KAS</button></li>
        </ul>
    </div>

    <div id="stocks" class="content-section active">
        <div class="card-main">
            <div class="text-center mb-4 text-muted fw-bold">
                <i class="fas fa-clock me-1"></i> Terakhir Update: <span class="text-primary"><%= lastUpdate %></span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light"><tr><th>Product Name</th><th>Qty</th><th class="text-center">Status</th></tr></thead>
                    <tbody>
                        <% stocks.forEach(s => { %>
                            <tr>
                                <td class="fw-bold text-uppercase"><%= s.nama %></td>
                                <td class="nowrap fw-bold text-muted"><%= s.display %></td>
                                <td class="text-center">
                                    <span class="badge-status <%= s.qty <= 0 ? 'bg-habis' : (s.qty <= 2 ? 'bg-low' : 'bg-aman') %>">
                                        <%= s.qty <= 0 ? 'Habis' : (s.qty <= 2 ? 'Low' : 'Tersedia') %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="shipping" class="content-section">
        <div class="card-main">
            <button class="btn-riwayat" id="btnShip" onclick="showFilter('shipFilter', 'tableShip', this)"><i class="fas fa-search-plus me-1"></i> LIHAT SEMUA RIWAYAT</button>
            <div id="shipFilter" class="filter-area" style="display:none; margin-bottom:15px;">
                <div class="row g-2">
                    <div class="col-6"><select id="sMonth" class="form-select" onchange="applyFilter('tableShip', 'sMonth', 'sYear')"><option value="">Bulan</option><option value="Januari">Januari</option><option value="Februari">Februari</option><option value="Maret">Maret</option><option value="April">April</option><option value="Mei">Mei</option><option value="Juni">Juni</option><option value="Juli">Juli</option><option value="Agustus">Agustus</option><option value="September">September</option><option value="Oktober">Oktober</option><option value="November">November</option><option value="Desember">Desember</option></select></div>
                    <div class="col-6"><select id="sYear" class="form-select year-list" onchange="applyFilter('tableShip', 'sMonth', 'sYear')"><option value="">Tahun</option></select></div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table text-center align-middle" id="tableShip">
                    <thead class="table-dark"><tr><th>Tanggal</th><th>SPX</th><th>JNE</th><th>J&T</th><th>Same/Inst</th><th class="text-end">TOT</th></tr></thead>
                    <tbody>
                        <% shippingAll.forEach((k, index) => { %>
                            <tr class="data-row" data-index="<%= index %>" data-total="<%= shippingAll.length %>">
                                <td class="nowrap fw-bold text-start tgl-format"><%= k.tgl %></td>
                                <td><%= k.spx %></td><td><%= k.jne %></td><td><%= k.jnt %></td><td><%= k.sd %></td>
                                <td class="nowrap fw-bold text-primary text-end"><%= k.tot %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="kas" class="content-section">
        <div class="saldo-card <%= saldoTotal.includes('-') ? 'saldo-minus' : '' %>">
            <small class="fw-bold opacity-75">SALDO KAS SAAT INI</small>
            <h1 class="fw-bold mt-1 nowrap"><%= saldoTotal %></h1>
        </div>
        <div class="card-main">
            <button class="btn-riwayat" id="btnKas" onclick="showFilter('kasFilter', 'tableKas', this)"><i class="fas fa-file-invoice-dollar me-1"></i> FILTER RIWAYAT KAS</button>
            <div id="kasFilter" class="filter-area" style="display:none; margin-bottom:15px;">
                <div class="row g-2">
                    <div class="col-6"><select id="kMonth" class="form-select" onchange="applyFilter('tableKas', 'kMonth', 'kYear')"><option value="">Pilih Bulan</option><option value="Januari">Januari</option><option value="Februari">Februari</option><option value="Maret">Maret</option><option value="April">April</option><option value="Mei">Mei</option><option value="Juni">Juni</option><option value="Juli">Juli</option><option value="Agustus">Agustus</option><option value="September">September</option><option value="Oktober">Oktober</option><option value="November">November</option><option value="Desember">Desember</option></select></div>
                    <div class="col-6"><select id="kYear" class="form-select year-list" onchange="applyFilter('tableKas', 'kMonth', 'kYear')"><option value="">Tahun</option></select></div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle" id="tableKas">
                    <thead class="table-light"><tr><th>Tanggal</th><th>Keterangan</th><th class="text-end">Mutasi</th><th class="text-center">Bukti</th></tr></thead>
                    <tbody>
                        <% kasAll.forEach((t, index) => { %>
                            <tr class="data-row" data-index="<%= index %>" data-total="<%= kasAll.length %>" style="font-size: 0.85rem;">
                                <td class="nowrap text-muted tgl-format"><%= t.tgl %></td>
                                <td><div class="fw-bold text-uppercase"><%= t.kat %></div><div class="small text-muted" style="font-size: 11px;"><%= t.ket %></div></td>
                                <td class="text-end nowrap">
                                    <div class="fw-bold <%= (t.debet && t.debet != '0' && t.debet != '-') ? 'text-danger' : 'text-success' %>">
                                        <%= (t.debet && t.debet != '0' && t.debet != '-') ? '-' + t.debet : (t.kredit && t.kredit != '0' && t.kredit != '-' ? '+' + t.kredit : '0') %>
                                    </div>
                                    <div class="text-muted" style="font-size: 10px;">Sisa: <%= t.saldo %></div>
                                </td>
                                <td class="text-center">
                                    <% if(t.bukti && t.bukti.toLowerCase().includes('http')) { %>
                                        <a href="<%= t.bukti %>" target="_blank" class="btn btn-sm btn-primary py-0 px-2" style="font-size: 10px; border-radius: 6px;">BUKTI</a>
                                    <% } else { %> - <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // Format Tanggal
    function formatDateString(str) { 
        if(!str || !str.includes('/')) return str; 
        const part = str.split('/'); 
        const date = new Date(part[2], part[1]-1, part[0]); 
        return date.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }); 
    }
    document.querySelectorAll('.tgl-format').forEach(el => { el.innerText = formatDateString(el.innerText); });

    // Tahun Otomatis
    const currentYear = new Date().getFullYear();
    document.querySelectorAll('.year-list').forEach(select => {
        for(let y = 2024; y <= currentYear + 2; y++) {
            let opt = document.createElement('option');
            opt.value = y; opt.innerHTML = y; select.appendChild(opt);
        }
    });

    // Tampilan 10 Terakhir
    function setInitialView() { 
        document.querySelectorAll('.data-row').forEach(row => { 
            const idx = parseInt(row.getAttribute('data-index')); 
            const total = parseInt(row.getAttribute('data-total')); 
            row.style.display = (idx < total - 10) ? 'none' : ''; 
        }); 
    }
    setInitialView();

    function openMenu(id, el) { 
        document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active')); 
        document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active')); 
        document.getElementById(id).classList.add('active'); 
        el.classList.add('active'); 
    }

    function showFilter(filterId, tableId, btn) { 
        const filter = document.getElementById(filterId); 
        if(filter.style.display === 'block') {
            filter.style.display = 'none'; 
            btn.innerHTML = btn.id === 'btnShip' ? '<i class="fas fa-search-plus me-1"></i> LIHAT SEMUA RIWAYAT' : '<i class="fas fa-file-invoice-dollar me-1"></i> FILTER RIWAYAT KAS';
            setInitialView();
        } else {
            filter.style.display = 'block'; 
            btn.innerHTML = '<i class="fas fa-compress-arrows-alt me-1"></i> TAMPILKAN RINGKAS'; 
            document.querySelectorAll(`#${tableId} .data-row`).forEach(r => r.style.display = ''); 
        }
    }

    function applyFilter(tableId, mId, yId) { 
        const m = document.getElementById(mId).value; 
        const y = document.getElementById(yId).value; 
        document.querySelectorAll(`#${tableId} .data-row`).forEach(row => { 
            const text = row.cells[0].innerText; 
            row.style.display = (text.includes(m) && text.includes(y)) ? "" : "none"; 
        }); 
    }
</script>
</body>
</html>
