<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SARINA DASHBOARD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f4f7f6; font-family: sans-serif; padding: 20px; }
        .card { border-radius: 15px; border: none; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .nav-pills .nav-link.active { background-color: #000; }
        .nav-link { color: #666; font-weight: bold; cursor: pointer; }
        .section { display: none; } .section.active { display: block; }
    </style>
</head>
<body>
    <div class="container" style="max-width: 500px;">
        <h2 class="text-center fw-bold mb-0">SARINA STORE</h2>
        <p class="text-center text-muted small mb-4">OPERATIONAL DASHBOARD</p>

        <ul class="nav nav-pills nav-justified bg-white p-1 rounded-pill mb-4 shadow-sm">
            <li class="nav-item"><a class="nav-link active" onclick="show('stok', this)">STOK</a></li>
            <li class="nav-item"><a class="nav-link" onclick="show('resi', this)">RESI</a></li>
        </ul>

        <div id="stok" class="section active">
            <div class="card p-3">
                <table class="table mb-0">
                    <% stocks.forEach(s => { %>
                        <tr>
                            <td><b><%= s.nama %></b></td>
                            <td class="text-end"><span class="badge bg-success"><%= s.statusTxt %></span></td>
                        </tr>
                    <% }) %>
                </table>
            </div>
        </div>

        <div id="resi" class="section">
            <div class="card p-4">
                <div class="mb-3">
                    <label class="small fw-bold">BULAN (Contoh: FEBRUARI 2026)</label>
                    <input type="text" id="bln" class="form-control" placeholder="FEBRUARI 2026">
                </div>
                <div class="mb-3">
                    <label class="small fw-bold">TANGGAL (Contoh: 01-02-2026)</label>
                    <input type="text" id="tgl" class="form-control" placeholder="01-02-2026">
                </div>
                <button onclick="cari()" class="btn btn-dark w-100 fw-bold">CARI DATA</button>
                <div id="hasil" class="mt-3"></div>
            </div>
        </div>
    </div>

    <script>
        function show(id, el) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            el.classList.add('active');
        }

        async function cari() {
            const b = document.getElementById('bln').value;
            const t = document.getElementById('tgl').value;
            const h = document.getElementById('hasil');
            if(!b || !t) return alert("Isi dulu Bos!");
            h.innerHTML = "Sabar, lagi nembak Google Drive...";
            try {
                const res = await fetch(`/get-resi?tgl=${t}&bulan=${b}`);
                const data = await res.json();
                if(!data || data.length === 0) { h.innerHTML = "Gak ada file, Bos!"; return; }
                let html = '<div class="list-group">';
                data.forEach(f => {
                    html += `<a href="${f.url}" target="_blank" class="list-group-item list-group-item-action small">${f.name}</a>`;
                });
                h.innerHTML = html + '</div>';
            } catch (e) { h.innerHTML = "Koneksi Gagal!"; }
        }
    </script>
</body>
</html>
